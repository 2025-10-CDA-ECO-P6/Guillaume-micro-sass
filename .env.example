# =============================================================================
# Nakama — variables d'environnement
# Copier ce fichier en .env et remplacer chaque valeur. .env est dans .gitignore.
# Générer un secret : openssl rand -base64 48
# =============================================================================

# PostgreSQL
POSTGRES_DB=nakama
POSTGRES_USER=nakama_admin
POSTGRES_PASSWORD=change-me-admin
NAKAMA_MIGRATION_PASSWORD=change-me-migration
NAKAMA_APP_PASSWORD=change-me-app

# Redis
REDIS_PASSWORD=change-me-redis

# JWT (HS256 : secret d'au moins 32 octets ; expiration 24 h en ms, cf. CDC)
JWT_SECRET=change-me-with-openssl-rand-base64-48
JWT_EXPIRATION=86400000

# Profil Spring : dev (avec jeu d'essai) ou prod (sans)
SPRING_PROFILES_ACTIVE=dev
